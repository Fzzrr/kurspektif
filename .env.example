# Salin file ini menjadi `.env`, lalu isi nilainya di SANA — bukan di sini.
# File ini ikut ter-commit ke GitHub, jadi JANGAN pernah menaruh nilai asli di sini.

# --- Database (Postgres, mis. Supabase) ---
# DATABASE_URL = koneksi POOLED, dipakai aplikasi saat runtime (src/lib/prisma.ts).
#                Supabase: port 6543, biasanya ada `?pgbouncer=true`.
# DIRECT_URL   = koneksi DIRECT/session, dipakai Prisma CLI untuk migrate (prisma.config.ts).
#                Supabase: port 5432.
DATABASE_URL=""
DIRECT_URL=""

# --- NextAuth v5 ---
# Pakai AUTH_SECRET yang LAMA agar sesi login yang sudah ada tetap valid.
# Kalau memang harus buat baru: `npx auth secret` (efeknya sesi lama hangus).
AUTH_SECRET=""

# Kredensial OAuth Google dari Google Cloud Console.
# Nama variabel WAJIB persis seperti ini — provider Google() dipanggil tanpa argumen
# di src/lib/auth/config.ts, jadi NextAuth membacanya lewat konvensi nama ini.
#
# HATI-HATI, gampang tertukar:
#   AUTH_GOOGLE_ID     -> Client ID,     berakhiran `.apps.googleusercontent.com`
#   AUTH_GOOGLE_SECRET -> Client secret, berawalan  `GOCSPX-`
#
# Redirect URI yang harus terdaftar: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Catatan: Apple TIDAK butuh kredensial — tombolnya sengaja disabled
# di src/components/auth/SocialAuthButtons.tsx.
